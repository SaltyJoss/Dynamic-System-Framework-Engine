<robot name="cube">

  <link name="Cube">
    <visual>
      <geometry>
        <mesh filename="package://meshes/cube.fbx"/>
      </geometry>
      <dsfe_material rgba="0.55 0.57 0.58 1.0" metallic="0.3" roughness="0.6"/>
    </visual>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.16666667" ixy="0" ixz="0" iyy="0.16666667" iyz="0" izz="0.16666667"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

</robot>